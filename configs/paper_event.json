{
  "paper": "Exploiting Privileged Information from Web Data for Action and Event Recognition",
  "paper_year": 2016,
  "experiment": "video_event_recognition",
  "source_dataset": {
    "name": "Flickr",
    "availability": "author-crawled; no released URL or precomputed MAT files found in the paper",
    "queries": ["birthday", "picnic", "parade", "show", "sports", "wedding"],
    "relevant_videos_per_query": 300,
    "irrelevant_videos_per_query": 300,
    "video_size_filter_mb": {
      "min": 5,
      "max": 100
    },
    "positive_bags": 60,
    "negative_bags": 60,
    "bag_size": 5,
    "positive_ratio_sigma": 0.6
  },
  "target_datasets": {
    "kodak": {
      "official_page": "https://www.ee.columbia.edu/ln/dvmm/consumervideo/",
      "classes": ["birthday", "picnic", "parade", "show", "sports", "wedding"],
      "reported_videos": 195
    },
    "ccv": {
      "official_page": "https://www.ee.columbia.edu/ln/dvmm/CCV/",
      "classes": ["birthday", "parade", "show", "sports", "wedding"],
      "reported_event_subset_videos": 2440
    }
  },
  "features": {
    "text": {
      "type": "term_frequency",
      "dimension": 2000,
      "vocabulary": "top_2000_words",
      "remove_stopwords": true
    },
    "visual": {
      "type": "improved_dense_trajectories_bow",
      "trajectory_length": 50,
      "sampling_stride": 16,
      "descriptors": {
        "HOG": {"dimension": 96, "clusters": 2000},
        "HOF": {"dimension": 108, "clusters": 2000},
        "MBH": {"dimension": 192, "clusters": 2000}
      },
      "dimension": 6000
    },
    "test_uses_text": false
  },
  "kernels": {
    "visual": "gaussian",
    "text": "linear"
  },
  "metrics": {
    "primary": "MAP",
    "definition": "mean one-vs-rest AP over the overlapping event classes"
  },
  "paper_parameters": {
    "sMIL-PI": {"C1": 100.0, "gamma": 100.0},
    "MI-SVM-PI": {"C1": 0.01, "gamma": 10.0},
    "MIL-CPB-PI": {"C1": 0.01, "gamma": 10.0},
    "sMIL-PI-DA": {"C2": 10.0, "lambda": 100.0},
    "MI-SVM-PI-DA": {"C2": 0.00001, "lambda": 100.0},
    "MIL-CPB-PI-DA": {"C2": 0.00001, "lambda": 100.0}
  },
  "matlab_demo_parameters": {
    "sMIL-PI": {"svm_C": 100.0, "gamma": 100.0, "rho": 0.6},
    "MI-SVM-PI": {"svm_C": 0.01, "gamma": 10.0, "pos_ratio": 0.8},
    "MIL-CPB-PI": {"svm_C": 0.01, "svm_C_star": 1.0, "gamma": 10.0, "pos_ratio": 0.6, "max_iter": 100},
    "sMIL-PI-DA": {"svm_C1": 100.0, "svm_C2": 100000.0, "gamma1": 100.0, "gamma2": 1000000.0, "rho": 0.6, "B": 10000000000.0, "epsilon": 0.0},
    "MI-SVM-PI-DA": {"svm_C1": 0.01, "svm_C2": 0.00001, "gamma1": 10.0, "gamma2": 100.0, "B": 10000000000.0, "epsilon": 0.0, "pos_ratio": 0.2, "max_iter": 3},
    "MIL-CPB-PI-DA": {"svm_C1": 0.01, "svm_C2": 0.00001, "gamma1": 10.0, "gamma2": 100.0, "B": 10000000000.0, "epsilon": 0.0, "pos_ratio": 0.2, "max_iter": 100}
  },
  "required_mat_files": ["visual_bags.mat", "text_bags.mat", "test_features.mat", "test_labels.mat"]
}
